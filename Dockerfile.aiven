FROM node:22-alpine AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.9.9 AS uv
FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends supervisor ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    AUTH_COOKIE_SECURE=true DATABASE_SSLMODE=verify-full \
    STATIC_DIRECTORY=/app/static SOURCE_CACHE_PATH=/tmp/research-cache.sqlite3 \
    PYTHONUNBUFFERED=1
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend/app ./app
COPY deploy/supervisord.conf ./supervisord.conf
COPY deploy/runtime_exit_on_fatal.py ./deploy/runtime_exit_on_fatal.py
COPY --from=frontend /frontend/dist ./static
RUN useradd --create-home app
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 \
    CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"]
CMD ["/app/.venv/bin/python", "-m", "app.runtime_start"]
