# Copy this file to .env and fill in the blank credentials.
# For Oxylabs browser tasks: set BROWSER_ENABLED=true and provide
# AGENT_API_TOKEN, GEMINI_API_KEY, OXY_AB_USERNAME and OXY_AB_PASSWORD.
# Also provide BROWSER_SESSION_KEY for saved logins and private sign-in inputs.

# Required for access to the app. Use a unique random token, at least 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=

# Required for real model replies and browser automation.
# Without a key, ordinary chat uses mock replies; browser tasks cannot run.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted as an alternative to GEMINI_API_KEY.

# Optional model overrides. These values match the configured defaults.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PLANNING_MODEL=gemini-3.5-flash
# Fast uses a separate planner; Auto/Deep use GEMINI_PLANNING_MODEL. All use minimal thinking.
GEMINI_FAST_PLANNING_MODEL=gemini-3.5-flash-lite
GEMINI_RESEARCH_MODEL=gemini-3.5-flash
GEMINI_VERIFICATION_MODEL=gemini-3.5-flash

# Required for Exa web research, independent of Oxylabs browser automation.
EXA_API_KEY=

# Docker development setup. Use COMPOSE_FILE=compose.yaml for production containers.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
FRONTEND_PORT=18000
BACKEND_PORT=18001
# Compose uses /data/chats.sqlite3 in its shared volume for both API and worker.
# For a backend running outside Docker, choose a writable local path instead.
CHAT_DATABASE_PATH=/data/chats.sqlite3
# Research profiles: Fast 1 round / 45 s; Auto 2 / 120 s; Deep 3 / 240 s.

# Set true to enable website tasks and the browser agent.
BROWSER_ENABLED=false
# oxylabs uses a remote browser. local requires an installed Playwright Chromium.
BROWSER_BACKEND=oxylabs
# Required when BROWSER_BACKEND=oxylabs: Oxylabs Agent Browser credentials.
# These are separate from the website-discovery API key below.
OXY_AB_USERNAME=
OXY_AB_PASSWORD=

# Optional: enables website discovery through Oxylabs MCP search.
# Without this key, provide the website URL in your request.
# OXYLABS_WEB_API_KEY is also accepted; OXYLAB_KEY takes precedence.
OXYLAB_KEY=

# Required for importing/saving logins and private passwords, OTPs and sign-in links.
# Generate a 32-byte key as 64 hex characters:
# python -c "import secrets; print(secrets.token_hex(32))"
# Keep this value stable and identical in the API and worker.
# Replacing it makes existing encrypted logins unreadable.
BROWSER_SESSION_KEY=

# Optional two-letter exit country, e.g. US, GB or FI. Blank uses provider routing.
BROWSER_COUNTRY=
# Fast browser decisions; page controls are extracted directly by Playwright.
BROWSER_MODEL=gemini-3.5-flash-lite
# Local Chromium only. Set false for manual takeover in a visible browser window.
BROWSER_HEADLESS=true
# Seconds per run (1-3540). Waiting for a user can extend the initial deadline.
BROWSER_DEADLINE_S=1800
# Keep the same chat's browser open for follow-ups after a reply (1–300 seconds).
BROWSER_IDLE_TIMEOUT_S=60
# Maximum tool calls (1-1000).
BROWSER_MAX_STEPS=120
# Seconds to answer an input, approval or takeover request (1-3540).
BROWSER_REQUEST_TIMEOUT_S=900
# Corrections for invalid tool arguments (1-20). This never repeats final submissions.
BROWSER_TOOL_RETRIES=5
# Gemini reasoning effort: minimal for speed, or low, medium, high.
BROWSER_THINKING_LEVEL=minimal
# Per-response token budget, including room for reasoning (1-65536).
BROWSER_MODEL_MAX_TOKENS=8192
# Seconds allowed for each model request (1-600).
BROWSER_MODEL_TIMEOUT_S=180
# Optional additional regular expression for buttons that require final approval.
# Built-in final-action checks remain enabled when this is blank.
BROWSER_FINAL_ACTION_PATTERNS=

# Vite outside Docker: put these in frontend/.env.local if needed.
# API_PROXY_TARGET=http://127.0.0.1:8000
# DEV_AUTH_TOKEN=<the same value as AGENT_API_TOKEN>
# Docker development sets both automatically. Do not use a VITE_ prefix for secrets.
