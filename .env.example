# Optional. Without a key, local mock replies are returned.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PLANNING_MODEL=gemini-3.5-flash
# Fast uses a separate planner; Auto/Deep use GEMINI_PLANNING_MODEL. All use minimal thinking.
GEMINI_FAST_PLANNING_MODEL=gemini-3.5-flash-lite
GEMINI_RESEARCH_MODEL=gemini-3.5-flash
GEMINI_VERIFICATION_MODEL=gemini-3.5-flash
EXA_API_KEY=
# Required for chat. Generate a unique random value with at least 32 characters.
AGENT_API_TOKEN=replace-with-a-random-token-at-least-32-characters
CHAT_DATABASE_PATH=/data/chats.sqlite3
COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Research profiles: Fast 1 round / 45 s; Auto 2 / 120 s; Deep 3 / 240 s.
